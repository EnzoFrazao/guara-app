# Só os NOMES das credenciais. Os valores reais ficam num .env no servidor, nunca no Git.

# Usuário guara_app: lê e escreve nas tabelas do sistema, sem ser superusuário.
DATABASE_URL=postgresql+psycopg://guara_app:troque-esta-senha@db:5432/guara

# Assina os tokens de login do painel (JWT de 15 min). Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo

# Um token por gateway, revogável pelo admin. JSON: {"id-do-gateway": "token"}
GATEWAY_TOKENS={"gw-01": "troque-este-token"}

# Token do controlador do relé (recebe só o bloqueio da própria área).
RELE_TOKENS={"rele-01": "troque-este-token"}
